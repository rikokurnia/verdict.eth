# Required on Vercel for ENSv2 Sepolia reads.
SEPOLIA_RPC_URL=https://your-sepolia-rpc-url

# Required for wallet connection. Safe to expose because this is a public app ID.
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Configure at least one server-only AI provider key.
GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# MUSESPARK_API_KEY=your-musespark-api-key

# Optional provider order and model overrides.
# AI_PROVIDERS=gemini,deepseek,muse
# GEMINI_MODEL=gemini-3.6-flash
# DEEPSEEK_MODEL=deepseek-chat
# MUSE_MODEL=muse-spark-1.1

# Optional sponsored Custom Auditor Factory on Vercel (server-only secrets).
# Use an authorized Sepolia relayer, never a mainnet wallet.
# VERDICT_SPONSORED_MINT_ENABLED=true
# Easiest: single-line raw key (must unlock the namespace operator address).
# VERDICT_RELAYER_PRIVATE_KEY=0x...
# Alternative: encrypted keystore pair (multi-line JSON mangles easily).
# VERDICT_RELAYER_KEYSTORE_JSON=<complete encrypted keystore JSON>
# VERDICT_RELAYER_KEYSTORE_PASSWORD=<keystore password>
